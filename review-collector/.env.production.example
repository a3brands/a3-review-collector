# Collector -- the keys that CHANGE when this moves off the laptop.
#
# This is a delta, not a whole file. .env.example remains the reference for all
# 74 settings and what they mean; everything not listed here keeps the value it
# already has on the laptop, and you should copy it across rather than retype it.
#
#   scp "rhea@laptop:.../review-collector/.env" /opt/review-collector/.env
#   # then apply the changes below
#   chmod 600 /opt/review-collector/.env && chown a3:a3 /opt/review-collector/.env
#
# NEVER commit the real .env. Both projects already gitignore it; the collector
# is not a git repo at all, which is a separate thing worth fixing.

# ---------------------------------------------------------------------------
# Paths. The laptop ran out of ~/Desktop; the server runs out of /opt.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:////opt/review-collector/data/reviews.db
#             ^^^^ four slashes. Three is a RELATIVE path, and the difference
#             is silent: the service starts, creates an empty database in its
#             working directory, reports zero reviews and re-emails everything
#             it then finds as new. This single character is the most damaging
#             typo available in this file.
LOG_FILE=/opt/review-collector/logs/collector.log

# ---------------------------------------------------------------------------
# Where the collector pushes reviews. Same host now, so loopback -- this stays
# as it is, and is listed only to make clear it should NOT become a tailnet or
# public URL. Two processes on one machine have no reason to leave the machine.
# ---------------------------------------------------------------------------
GRM_URL=http://127.0.0.1:3999
GRM_ENABLED=true

# ---------------------------------------------------------------------------
# The dashboard link in notification emails. On the laptop this pointed at
# http://127.0.0.1:8080/ -- correct only for someone sitting at that laptop.
# Point it at the Responder's public funnel address instead, which is what the
# recipient can actually open.
# ---------------------------------------------------------------------------
NOTIFY_DASHBOARD_URL=https://CHANGEME.ts.net/dashboard

# ---------------------------------------------------------------------------
# Secrets to ROTATE during the move, not copy. These have lived in plaintext on
# a laptop that travels; a migration is the cheapest moment to retire them.
# Generate with:  openssl rand -hex 32
# GRM_INGEST_SECRET must be changed in BOTH files at the same time or ingestion
# starts failing signature checks and reviews stop reaching the dashboard.
# ---------------------------------------------------------------------------
A3_API_KEY=
GRM_INGEST_SECRET=

# ---------------------------------------------------------------------------
# Playwright. Unchanged from the laptop, and repeated here only because it is
# the part people "tidy up" on a server and then wonder why Google started
# serving review-free pages.
#
# PLAYWRIGHT_HEADLESS was already true on the laptop, so headless is not a new
# risk introduced by the move. The warm-up visit and the desktop user agent are
# what make Google serve the full listing -- measured at 14/14 with them versus
# 2/8 without. Do not remove them to "simplify" the server config.
# ---------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_WARM_SESSION=true
# Must agree with TZ= in the systemd unit. Relative dates ("2 weeks ago") are
# resolved against it, so a mismatch shifts every scraped review date.
PLAYWRIGHT_TIMEZONE=America/Chicago

# ---------------------------------------------------------------------------
# Unchanged, listed so nobody "fixes" them during the move:
#   CHECK_INTERVAL_MINUTES=15      the schedule you asked for
#   SCHEDULER_ENABLED=true         the 15-minute loop lives in this process
#   COLLECTOR_BACKEND=auto         GBP API when credentials work, else scraper
#   NOTIFY_ENABLED=true            emails on
#   SMTP_*                         copy from the laptop verbatim
#   BMW_FWB_* / MB_FWB_*           fallback only; the Responder is the real
#                                  source of the dealership list
# ---------------------------------------------------------------------------
